{
  "schemaVersion": "tradecsv.mapping/0.1",
  "formatId": "example-broker-spot-fills",
  "columns": {
    "trade_id": "Trade ID",
    "executed_at": "Time",
    "base_asset": "Coin",
    "side": "Side",
    "price": "Price",
    "quantity": "Amount",
    "fee_amount": "Fee",
